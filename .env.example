# ============================================
# Lab DMS — Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit the .env file to version control

# --- Database ---
DB_PASSWORD=change_me_to_a_strong_password

# --- Redis ---
REDIS_PASSWORD=change_me_to_a_strong_redis_password

# --- JWT ---
# Generate with: openssl rand -base64 64
JWT_SECRET=change_me_to_a_256_bit_secret_key
JWT_EXPIRATION_MS=28800000        # 8 hours (dev-friendly session)
JWT_REFRESH_EXPIRATION_MS=604800000  # 7 days

# --- Ports ---
FRONTEND_PORT=3000
BACKEND_PORT=8080

# --- Frontend ---
# API URL baked into the frontend at BUILD time.
# Default "/api/v1" uses the nginx proxy inside the frontend container
# (recommended: same-origin, no CORS). Only change if serving the API
# from a different host, e.g. http://localhost:8080/api/v1
VITE_API_URL=/api/v1

# --- CORS (only needed for direct API access, e.g. npm run dev) ---
FRONTEND_URL=http://localhost:3000

# --- Spring Profile ---
SPRING_PROFILE=dev

# --- LaTeX ---
LATEX_TIMEOUT_SECONDS=60
LATEX_MAX_MEMORY=512m

# --- Single sign-on (Keycloak) — optional, see KEYCLOAK.md ---
# SSO_ENABLED=true
# SSO_ISSUER_URI=http://localhost:8180/realms/lab-dms
# SSO_CLIENT_ID=lab-dms
# SSO_AUDIENCE=
# SSO_ROLES_CLAIM=realm_access.roles
# SSO_SYNC_ROLES=true
# SSO_AUTO_PROVISION=true
# SSO_DEFAULT_ROLES=ROLE_VIEWER
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=change_me
# KEYCLOAK_PORT=8180

# --- Storage housekeeping ---
# Unreferenced blobs older than this are deleted by the nightly collector.
STORAGE_GC_GRACE_HOURS=24
